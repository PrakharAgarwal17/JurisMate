NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# MongoDB URI without a database name; the app selects the jurismate database.
MONGO_URL=mongodb://127.0.0.1:27017

# Generate separate long random secrets for access and refresh tokens.
ACCESS_SECRET_KEY=
REFRESH_SECRET_KEY=
COOKIE_SAME_SITE=lax

# Gmail app password (not your normal Gmail password).
EMAIL=
PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

CLOUD_NAME=
API_KEY=
API_SECRET=

# Switch Agent Bridge URL (not the Gateway URL) and agent API credentials.
# Connect Discord/Slack rooms in Switch Console, then add their Switch room IDs in JurisMate.
SWITCH_AGENT_BRIDGE_URL=
SWITCH_REGISTRATION_TOKEN=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=

# Gemini API key from Google AI Studio; content sent for analysis goes to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
